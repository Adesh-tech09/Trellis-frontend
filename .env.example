# Environment Variables Template

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Agent telemetry WebSocket (optional — omit to use built-in mock stream in the dashboard)
# NEXT_PUBLIC_TELEMETRY_WS_URL=ws://127.0.0.1:3456
# TELEMETRY_WS_PORT=3456

# Metrics dashboard (optional — omit to use built-in mock metrics)
# Prometheus HTTP API base URL (server-side only; do NOT prefix with NEXT_PUBLIC)
# Example: http://localhost:9090
# METRICS_PROMETHEUS_BASE_URL=
#
# If using OpenTelemetry Collector, you can point this at its Prometheus exporter
# Example: http://localhost:9464
# METRICS_OTEL_PROMETHEUS_BASE_URL=

# OpenTelemetry OTLP metric export (optional — omit to keep metrics local)
# Base collector endpoint; "/v1/metrics" is appended automatically.
# Example: http://localhost:4318
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
#
# Signal-specific override (used as-is when it already ends in /v1/metrics)
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
#
# Transport hint: http/json (default), http/protobuf, or grpc. The client always
# transmits OTLP/HTTP JSON, so point gRPC setups at the collector's HTTP endpoint.
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_PROTOCOL=http/json
#
# Comma-separated collector headers, e.g. authorization=Bearer <token>
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_HEADERS=
#
# Batch export interval in milliseconds (default 30000)
# NEXT_PUBLIC_OTEL_METRIC_EXPORT_INTERVAL=30000
#
# Resource service name reported to the collector (default trellis-frontend)
# NEXT_PUBLIC_OTEL_SERVICE_NAME=trellis-frontend
