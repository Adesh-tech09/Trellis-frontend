# Environment Variables Template

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Agent telemetry WebSocket (optional — omit to use built-in mock stream in the dashboard)
# NEXT_PUBLIC_TELEMETRY_WS_URL=ws://127.0.0.1:3456
# TELEMETRY_WS_PORT=3456

# Metrics dashboard (optional — omit to use built-in mock metrics)
# Prometheus HTTP API base URL (server-side only; do NOT prefix with NEXT_PUBLIC)
# Example: http://localhost:9090
# METRICS_PROMETHEUS_BASE_URL=
#
# If using OpenTelemetry Collector, you can point this at its Prometheus exporter
# Example: http://localhost:9464
# METRICS_OTEL_PROMETHEUS_BASE_URL=

# Operational health (GET /api/operational-health — optional overrides)
# When unset, the Stellar probe uses the selected network's RPC URL (falling back
# to its Horizon URL), the IPFS probe uses the public gateway, and the WebSocket
# probe is reported as unmeasured because no socket URL is configured.
# OPERATIONAL_HEALTH_RPC_URL=https://soroban-testnet.stellar.org
# OPERATIONAL_HEALTH_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
# OPERATIONAL_HEALTH_WS_URL=ws://127.0.0.1:3456
#
# Per-probe timeout in milliseconds (default 2500) so a slow dependency cannot
# hold the status endpoint open.
# OPERATIONAL_HEALTH_PROBE_TIMEOUT_MS=2500
#
# Set to "off" to score the incident backlog without making any outbound probe.
# OPERATIONAL_HEALTH_PROBES=on
